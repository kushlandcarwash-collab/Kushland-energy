    <script>
        // Mobile Nav Toggle
        const navToggle = document.getElementById('navToggle');
        const navLinks = document.getElementById('navLinks');

        navToggle.addEventListener('click', function() {
            navLinks.classList.toggle('open');
            const icon = this.querySelector('i');
            icon.className = navLinks.classList.contains('open') ? 'fas fa-times' : 'fas fa-bars';
        });

        document.querySelectorAll('.nav-links a').forEach(link => {
            link.addEventListener('click', () => {
                navLinks.classList.remove('open');
                navToggle.querySelector('i').className = 'fas fa-bars';
            });
        });

        // Toast
        const toast = document.getElementById('toast');
        const toastMessage = document.getElementById('toastMessage');
        let toastTimeout;

        function showToast(message) {
            toastMessage.textContent = message || 'Download started!';
            toast.classList.add('show');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => toast.classList.remove('show'), 4000);
        }

        function simulateDownload(type) {
            showToast(`📲 ${type} download starting...`);
            console.log(`[Download] ${type} requested.`);
            
            // In production, redirect to actual APK URL:
            // window.location.href = 'https://kushlandenergy.com/downloads/app.apk';
        }

        // Smooth Scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        // Operator Registration Form
        function toggleCheckbox(label) {
            const checkbox = label.querySelector('input[type="checkbox"]');
            checkbox.checked = !checkbox.checked;
            label.classList.toggle('selected', checkbox.checked);
        }

        function handleOperatorSubmit(event) {
            event.preventDefault();
            
            const btn = document.getElementById('submitBtn');
            const success = document.getElementById('formSuccess');
            
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';
            btn.disabled = true;
            
            const formData = {
                businessName: document.getElementById('businessName').value,
                businessType: document.getElementById('businessType').value,
                city: document.getElementById('city').value,
                area: document.getElementById('area').value,
                address: document.getElementById('address').value,
                phone: document.getElementById('phone').value,
                email: document.getElementById('email').value,
                website: document.getElementById('website').value,
                plan: document.getElementById('plan').value,
                notes: document.getElementById('notes').value,
                services: Array.from(
                    document.querySelectorAll('#serviceCheckboxes input:checked')
                ).map(el => el.value)
            };
            
            console.log('Operator Registration:', formData);
            
            // Send to backend API
            // fetch('/api/operator-register', {
            //     method: 'POST',
            //     headers: { 'Content-Type': 'application/json' },
            //     body: JSON.stringify(formData)
            // });
            
            setTimeout(() => {
                btn.innerHTML = '<i class="fas fa-check"></i> Submitted!';
                btn.style.background = '#059669';
                success.classList.add('show');
                
                setTimeout(() => {
                    btn.innerHTML = '<i class="fas fa-paper-plane"></i> Register Now – Free Trial';
                    btn.style.background = '#22c55e';
                    btn.disabled = false;
                }, 3000);
                
                showToast('✅ Registration submitted successfully!');
            }, 2000);
        }

        // Grid Status Updates
        function updateGridStatus() {
            const statuses = [
                { grid: 'online', backup: '92%', wait: '4 min' },
                { grid: 'online', backup: '85%', wait: '2 min' },
                { grid: 'offline', backup: '100%', wait: '6 min' },
                { grid: 'online', backup: '78%', wait: '3 min' },
            ];
            const s = statuses[Math.floor(Math.random() * statuses.length)];
            const gridEl = document.querySelector('.mock-grid-status');
            if (gridEl) {
                gridEl.innerHTML = `
                    <span><i class="fas fa-bolt"></i> Grid: <span class="${s.grid === 'online' ? 'online' : 'offline'}">● ${s.grid === 'online' ? 'Online' : 'Offline'}</span></span>
                    <span><i class="fas fa-database"></i> Backup: <span class="online">● ${s.backup}</span></span>
                    <span><i class="fas fa-clock"></i> Wait: ${s.wait}</span>
                `;
            }
        }

        setInterval(updateGridStatus, 15000);
        updateGridStatus();

        console.log('Kushland Unified Energy Hub website loaded.');
    </script>

