            .features-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
            .feature-card { padding: 16px 14px; }
            .fleet-grid { grid-template-columns: 1fr; }
            .shift-grid { grid-template-columns: 1fr; }
            .operator-benefits { grid-template-columns: 1fr; }
            .operator-pricing { grid-template-columns: 1fr; max-width: 300px; margin: 16px auto 0; }
            .form-row { grid-template-columns: 1fr; }
            .form-group .service-checkboxes { grid-template-columns: 1fr; }
            .footer .container { grid-template-columns: 1fr; text-align: center; }
            
            .hero-stats { gap: 20px; flex-wrap: wrap; }
            .android-mockup { max-width: 260px; }
            
            .bank-logos { gap: 16px 24px; }
            .bank-item .bank-icon { width: 44px; height: 44px; font-size: 1.1rem; }
            .language-grid { gap: 10px; }
            .language-item { font-size: 0.8rem; padding: 6px 14px; }
        }

        @media (max-width: 480px) {
            .features-grid { grid-template-columns: 1fr; }
            .btn-primary { padding: 12px 20px; font-size: 0.9rem; }
            .download-buttons { flex-direction: column; align-items: center; }
